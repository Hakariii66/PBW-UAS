<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Abaikan file atau direktori fisik (CSS, JS, gambar, dsb.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Arahkan semua request lainnya ke index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
